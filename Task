    public static void StringTrim(String x){
        
        int count=0;
        int o_count=0;
        String TrimmedString="";
        for(int i =2 ; i<x.length()-2;i++){
            count++;
            System.out.print(x.charAt(i));
            TrimmedString+=x.charAt(i);
        
            if(x.charAt(i)=='o' || x.charAt(i)=='O')
                o_count+=1;

        }
        System.out.println();
         System.out.print(count);
        
        ///////////////////////
        System.out.println();
        System.out.print(TrimmedString.toLowerCase());
        ///////////////////////
         System.out.println();
         System.out.print(o_count);
         ///////////////////////
         System.out.println();
         System.out.println(TrimmedString.replace(' ', '_'));
        
    }
    
    
    public static void GradeCalculator(int[] s){
        int[] scores=new int [5];
